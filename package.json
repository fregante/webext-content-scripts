{
	"name": "webext-content-scripts",
	"version": "3.1.0",
	"description": "Utility functions to inject content scripts in WebExtensions, for Manifest v3",
	"license": "MIT",
	"repository": "fregante/webext-content-scripts",
	"funding": "https://github.com/sponsors/fregante",
	"author": "Federico Brigante <me@fregante.com> (https://fregante.com)",
	"type": "module",
	"exports": {
		"types": "./index.d.ts",
		"default": "./index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc",
		"prepare": "tsc --sourceMap false",
		"test": "xo && tsc && node --test",
		"watch": "tsc --watch"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"types.d.ts"
	],
	"keywords": [
		"contentscript",
		"injection",
		"manifest",
		"chrome",
		"firefox",
		"browser",
		"extension",
		"executescript",
		"insertcss",
		"mv3"
	],
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/chrome": "^0.3.5",
		"@types/node": "^24.0.0",
		"typescript": "^6.0.3",
		"xo": "^5.0.1"
	}
}
